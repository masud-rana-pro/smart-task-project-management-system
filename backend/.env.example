# Copy to backend/.env. Never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Use isolated project databases only. These are placeholders, not working credentials.
DATABASE_URL=postgresql://smart_task:REPLACE_ME@127.0.0.1:5432/smart_task_dev
DIRECT_URL=postgresql://smart_task:REPLACE_ME@127.0.0.1:5432/smart_task_dev
TEST_DATABASE_URL=postgresql://smart_task:REPLACE_ME@127.0.0.1:5432/smart_task_test
# Generate a unique random secret (at least 64 characters); never reuse a database password.
SESSION_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS
APP_ORIGIN=http://127.0.0.1:5173
# Leave 0 locally. Hosting proxy configuration must be verified before changing it.
TRUST_PROXY_HOPS=0

# Local Admin bootstrap / fictional seed only. These are app-login passwords,
# separate from the PostgreSQL login password in DATABASE_URL.
ADMIN_NAME=Demo Administrator
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_APP_LOGIN_PASSWORD
DEMO_MEMBER_PASSWORD=REPLACE_WITH_A_DIFFERENT_UNIQUE_APP_LOGIN_PASSWORD
# Do not enable seeding in production. Opt in only for an approved local target.
ALLOW_DEMO_SEED=false
