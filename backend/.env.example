# Copy to backend/.env. Never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Use isolated project databases only. These are placeholders, not working credentials.
DATABASE_URL=postgresql://smart_task:REPLACE_ME@127.0.0.1:5432/smart_task_dev
DIRECT_URL=postgresql://smart_task:REPLACE_ME@127.0.0.1:5432/smart_task_dev
TEST_DATABASE_URL=postgresql://smart_task:REPLACE_ME@127.0.0.1:5432/smart_task_test
# Session support is planned for M2; use a unique random secret then.
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
