{
  "name": "smart-task-project-management-system",
  "version": "0.1.0",
  "description": "Smart Task project management assessment prototype",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces",
    "test:e2e": "npm run build -w backend && playwright test",
    "db:generate": "npm run db:generate -w backend",
    "db:validate": "npm run db:validate -w backend",
    "db:migrate": "npm run db:migrate -w backend",
    "db:deploy": "npm run db:deploy -w backend",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "admin:create": "npm run admin:create -w backend",
    "db:seed": "npm run db:seed -w backend"
  },
  "workspaces": [
    "frontend",
    "backend"
  ],
  "private": true,
  "engines": {
    "node": ">=24.16.0 <25",
    "npm": ">=11 <12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  }
}
